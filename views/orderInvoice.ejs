<%
  const adminView = typeof isAdminView !== 'undefined' ? isAdminView : false;
  const paymentMethod = String(order.payment_method || '').toLowerCase();
  const paymentRef = String(order.payment_reference || '').toLowerCase();
  const isCard = paymentMethod === 'card';
  const cardBrand = isCard && (paymentRef === 'visa' || paymentRef === 'mastercard') ? paymentRef : '';
  let paymentLabel = 'Payment';
  if (isCard && cardBrand === 'visa') {
    paymentLabel = 'Paid by Visa card';
  } else if (isCard && cardBrand === 'mastercard') {
    paymentLabel = 'Paid by Mastercard';
  } else if (isCard) {
    paymentLabel = 'Paid by card';
  } else if (paymentMethod === 'paypal') {
    paymentLabel = 'Paid by PayPal';
  } else if (paymentMethod === 'nets') {
    paymentLabel = 'Paid by NETS QR';
  } else if (paymentMethod) {
    paymentLabel = `Paid by ${paymentMethod}`;
  }
  const invoiceStyles = adminView
    ? `
      body { background: linear-gradient(135deg, #0f172a 0%, #1a2847 100%); color: #e2e8f0; font-family: 'Segoe UI','Helvetica Neue',Arial,sans-serif; }
      .invoice-header-section { background: linear-gradient(135deg, rgba(59,130,246,0.15) 0%, rgba(139,92,246,0.15) 100%); border-radius: 16px; padding: 24px; border: 1px solid rgba(59,130,246,0.2); margin-bottom: 24px; }
      .invoice-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 18px; color: #e2e8f0; box-shadow: 0 25px 50px rgba(0,0,0,0.4); }
      .table { color: #e2e8f0; background: rgba(255,255,255,0.02); }
      .table > :not(caption) > * > * { background-color: transparent !important; border-color: rgba(255,255,255,0.08); color: #e2e8f0; }
      .table thead th { color: #cbd5e1; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; font-weight: 700; background: rgba(59,130,246,0.1); }
      .table tbody tr { border-bottom: 1px solid rgba(255,255,255,0.05); transition: background-color 0.2s; }
      .table tbody tr:hover { background-color: rgba(59,130,246,0.05); }
      .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
      .status-paid { background: rgba(34,197,94,0.2); color: #86efac; border: 1px solid rgba(34,197,94,0.4); }
      .order-number { font-size: 2.5rem; font-weight: 800; background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      .customer-info-card { background: rgba(255,255,255,0.04); border-radius: 12px; padding: 16px; border: 1px solid rgba(255,255,255,0.08); }
      .info-label { color: #94a3b8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .info-value { color: #e2e8f0; font-weight: 600; margin-top: 4px; }
      .payment-section { background: rgba(255,255,255,0.03); border-radius: 12px; padding: 16px; border-left: 3px solid #3b82f6; margin-top: 20px; }
      .btn-outline-secondary { color: #cbd5e1; border-color: #475569; }
      .btn-outline-secondary:hover { background-color: #475569; color: #e2e8f0; }
    `
    : `
      body { background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); font-family: 'Segoe UI','Helvetica Neue',Arial,sans-serif; }
      .invoice-header-section { background: linear-gradient(135deg, rgba(59,130,246,0.08) 0%, rgba(139,92,246,0.08) 100%); border-radius: 16px; padding: 24px; border: 2px solid rgba(59,130,246,0.15); margin-bottom: 24px; }
      .invoice-card { border: none; border-radius: 18px; box-shadow: 0 20px 45px rgba(15,23,42,0.12); background: white; }
      .table { background: white; }
      .table thead th { background: linear-gradient(135deg, rgba(59,130,246,0.1) 0%, rgba(139,92,246,0.1) 100%); color: #1e293b; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; font-weight: 700; }
      .table tbody tr { border-bottom: 1px solid rgba(203,213,225,0.5); transition: background-color 0.2s; }
      .table tbody tr:hover { background-color: rgba(59,130,246,0.03); }
      .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
      .status-paid { background: rgba(34,197,94,0.15); color: #16a34a; border: 1px solid rgba(34,197,94,0.3); }
      .order-number { font-size: 2.5rem; font-weight: 800; background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      .customer-info-card { background: linear-gradient(135deg, rgba(59,130,246,0.05) 0%, rgba(139,92,246,0.05) 100%); border-radius: 12px; padding: 16px; border: 1px solid rgba(59,130,246,0.15); }
      .info-label { color: #64748b; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
      .info-value { color: #0f172a; font-weight: 600; margin-top: 4px; }
      .payment-section { background: linear-gradient(135deg, rgba(59,130,246,0.05) 0%, rgba(139,92,246,0.05) 100%); border-radius: 12px; padding: 16px; border-left: 4px solid #3b82f6; margin-top: 20px; }
      .btn-outline-secondary { color: #0f172a; border-color: #cbd5e1; }
      .btn-outline-secondary:hover { background-color: #0f172a; color: white; border-color: #0f172a; }
      img { border-radius: 8px; }
    `;
%>
<%- include('partials/header', { pageTitle: 'Invoice', user, customStyles: invoiceStyles, bodyClass: adminView ? 'bg-dark' : 'bg-light' }) %>

<div class="container py-5" style="max-width: 1000px;">
  <!-- Header Section -->
  <div class="invoice-header-section">
    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <p class="text-uppercase small fw-semibold mb-2" style="color: #94a3b8; letter-spacing: 0.1em;">Order Invoice</p>
        <% if (adminView) { %>
          <div class="order-number mb-3">Order #<%= order.id %></div>
        <% } %>
        <div style="color: #94a3b8; font-size: 0.95rem;">
          📅 Placed <%= new Date(order.created_at).toLocaleString() %>
        </div>
      </div>
      <div class="text-end">
        <div class="status-badge status-paid" style="display: inline-block;">
          ✓ <%= order.status.toUpperCase() %>
        </div>
        <button class="btn btn-outline-secondary btn-sm mt-3" onclick="window.print()" style="border-radius: 8px;">
          🖨️ Print Invoice
        </button>
      </div>
    </div>

    <!-- Customer Info Section -->
    <div class="row mt-4 g-3">
      <div class="col-md-6">
        <div class="customer-info-card">
          <div class="info-label">📦 Ship To</div>
          <% if (order.username) { %>
            <div class="info-value"><%= order.username %></div>
            <div style="color: #94a3b8; font-size: 0.9rem; margin-top: 8px;"><%= order.email %></div>
            <% if (order.address) { %>
              <div style="color: #94a3b8; font-size: 0.9rem; margin-top: 8px;">📍 <%= order.address %></div>
            <% } %>
            <% if (order.contact) { %>
              <div style="color: #94a3b8; font-size: 0.9rem; margin-top: 8px;">☎️ <%= order.contact %></div>
            <% } %>
          <% } else if (user) { %>
            <div class="info-value"><%= user.username %></div>
            <div style="color: #94a3b8; font-size: 0.9rem; margin-top: 8px;"><%= user.email %></div>
          <% } %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="customer-info-card">
          <div class="info-label">💳 Payment Details</div>
          <div class="info-value"><%= paymentLabel %></div>
          <% if (isCard && cardBrand) { %>
            <div style="color: #94a3b8; font-size: 0.85rem; margin-top: 12px;">
              <span class="info-label">Card network:</span><br>
              <span style="color: inherit; font-weight: 600;"><%= cardBrand === 'visa' ? 'Visa' : 'Mastercard' %></span>
            </div>
          <% } else if (order.payment_reference) { %>
            <div style="color: #94a3b8; font-size: 0.85rem; margin-top: 12px; word-break: break-all;">
              <span class="info-label">Transaction ID:</span><br>
              <span style="color: inherit; font-family: monospace; font-size: 0.9rem;"><%= order.payment_reference %></span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Order Items Section -->
  <div class="card invoice-card mb-4">
    <div class="card-body p-4">
      <h5 class="mb-4" style="color: #1e293b; font-weight: 700;">📋 Order Items</h5>
      <div class="table-responsive">
        <table class="table align-middle" style="margin-bottom: 0;">
          <thead>
            <tr>
              <th style="width: 30%;">Product</th>
              <th style="width: 15%; text-align: center;">Image</th>
              <th style="width: 15%; text-align: center;">Qty</th>
              <th style="width: 20%; text-align: right;">Unit Price</th>
              <th style="width: 20%; text-align: right;">Line Total</th>
            </tr>
          </thead>
          <tbody>
            <% let runningTotal = 0; %>
            <% items.forEach(function(item, index) {
                 const displayName = item.productName || item.product_name_snapshot || 'Product';
                 const image = item.image || item.product_image_snapshot;
                 const lineTotal = Number(item.price_at_purchase) * Number(item.quantity);
                 runningTotal += lineTotal;
            %>
              <tr>
                <td style="font-weight: 600; vertical-align: middle;"><%= displayName %></td>
                <td style="text-align: center;">
                  <% if (image) { %>
                    <img src="<%= image.startsWith('http') ? image : '/images/' + image %>" alt="<%= displayName %>" width="60" height="60" style="object-fit: cover;">
                  <% } else { %>
                    <span style="color: #94a3b8; font-size: 0.9rem;">—</span>
                  <% } %>
                </td>
                <td style="text-align: center; font-weight: 500;"><%= item.quantity %></td>
                <td style="text-align: right; font-weight: 500;">$<%= Number(item.price_at_purchase).toFixed(2) %></td>
                <td style="text-align: right; font-weight: 600; font-size: 1.05rem;">$<%= lineTotal.toFixed(2) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot style="border-top: 2px solid rgba(59,130,246,0.2);">
            <tr>
              <th colspan="4" style="text-align: right; padding-top: 20px; font-size: 1.1rem;">💰 Total:</th>
              <th style="text-align: right; padding-top: 20px; font-size: 1.2rem; color: #3b82f6;">$<%= Number(order.total_amount || runningTotal).toFixed(2) %></th>
            </tr>
          </tfoot>
        </table>
      </div>
  <!-- Action Section -->
  <div class="d-flex justify-content-center gap-3 mt-5">
    <% if (adminView) { %>
      <a href="/admin/orders" class="btn btn-outline-secondary" style="border-radius: 8px; padding: 10px 24px;">← Back to Orders</a>
    <% } else { %>
      <a href="/orders" class="btn btn-outline-secondary" style="border-radius: 8px; padding: 10px 24px;">← Back to History</a>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
