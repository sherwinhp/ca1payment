<%
  const registerStyles = `
    body {
      background: radial-gradient(circle at 15% 20%, #e0f2fe 0, transparent 30%),
                  radial-gradient(circle at 85% 10%, #fef9c3 0, transparent 30%),
                  radial-gradient(circle at 80% 80%, #dcfce7 0, transparent 30%),
                  #f7f8fb;
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    }
    .auth-card {
      border: none;
      border-radius: 24px;
      box-shadow: 0 25px 45px rgba(15, 23, 42, 0.12);
      overflow: hidden;
    }
    .auth-hero {
      background: linear-gradient(135deg, #22c55e, #0ea5e9);
      color: #fff;
    }
    .auth-hero h1 {
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .form-control {
      border-radius: 12px;
      padding: 0.75rem;
    }
    .btn-primary {
      border-radius: 12px;
      padding: 0.75rem;
      font-weight: 700;
      background: #22c55e;
      border-color: #22c55e;
    }
    .btn-primary:hover {
      background: #16a34a;
      border-color: #16a34a;
    }
  `;
%>
<%- include('partials/header', { pageTitle: 'Register', bodyClass: 'bg-light', user, customStyles: registerStyles }) %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card auth-card">
        <div class="row g-0">
          <div class="col-md-5 auth-hero p-4 d-flex flex-column justify-content-between">
            <div>
              <p class="text-uppercase small mb-2" style="letter-spacing: 0.2rem;">Create account</p>
              <h1 class="display-6 mb-3">Join the fresh food club.</h1>
              <p class="mb-0">Save your cart, track orders, and share trusted reviews with fellow shoppers.</p>
            </div>
            <div class="mt-4">
              <p class="small mb-1 text-white-75">Already have an account?</p>
              <a href="/login" class="btn btn-light w-100">Login</a>
            </div>
          </div>
          <div class="col-md-7 p-4 p-lg-5 bg-white">
            <% if (messages && messages.length > 0) { %>
              <div class="alert alert-danger rounded-3">
                <% messages.forEach(function(message) { %>
                  <div><%= message %></div>
                <% }); %>
              </div>
            <% } %>

            <form action="/register" method="POST" class="d-flex flex-column gap-3 mt-2">
              <div>
                <label for="username" class="form-label fw-semibold">Username</label>
                <input
                  type="text"
                  id="username"
                  name="username"
                  class="form-control"
                  placeholder="Pick a unique name"
                  required
                  value="<%= formData && formData.username ? formData.username : '' %>"
                >
              </div>

              <div>
                <label for="email" class="form-label fw-semibold">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-control"
                  placeholder="you@example.com"
                  required
                  value="<%= formData && formData.email ? formData.email : '' %>"
                >
              </div>

              <div>
                <label for="password" class="form-label fw-semibold">Password</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="Min 6 chars, use a number & symbol" required>
                <small class="text-muted">Min 6 chars; include at least one number and one special character.</small>
              </div>

              <div class="row g-3">
                <div class="col-sm-12">
                  <label for="address" class="form-label fw-semibold">Address</label>
                  <input
                    type="text"
                    id="address"
                    name="address"
                    class="form-control"
                    placeholder="Street, city, postal code"
                    required
                    value="<%= formData && formData.address ? formData.address : '' %>"
                  >
                </div>
                <div class="col-sm-12">
                  <label for="contact" class="form-label fw-semibold">Contact Number</label>
                  <input
                    type="text"
                    id="contact"
                    name="contact"
                    class="form-control"
                    placeholder="e.g. 98765432"
                    required
                    value="<%= formData && formData.contact ? formData.contact : '' %>"
                  >
                </div>
              </div>

              <p class="text-muted small mb-2">
                All new accounts start as shoppers. Admins can promote accounts to admin when needed.
              </p>

              <button type="submit" class="btn btn-primary w-100">Create account</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
