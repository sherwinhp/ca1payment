<%
  const historyStyles = `
    body {
      background: radial-gradient(circle at 10% 20%, #e0f2fe 0, transparent 25%),
                  radial-gradient(circle at 90% 10%, #fef3c7 0, transparent 25%),
                  radial-gradient(circle at 85% 80%, #dcfce7 0, transparent 25%),
                  #f8fafc;
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    }
    .order-card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 18px 36px rgba(15, 23, 42, 0.1);
    }
    .status-badge {
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
  `;
  const formatPaymentLabel = (order) => {
    const method = String(order.payment_method || '').toLowerCase();
    const ref = String(order.payment_reference || '').toLowerCase();
    if (method === 'card') {
      if (ref === 'visa') return 'Paid by Visa card';
      if (ref === 'mastercard') return 'Paid by Mastercard';
      return 'Paid by card';
    }
    if (method === 'paypal') return 'Paid by PayPal';
    if (method === 'nets') return 'Paid by NETS QR';
    return method ? `Paid by ${method}` : 'Payment';
  };
%>
<%- include('partials/header', { pageTitle: 'Order History', user, bodyClass: 'bg-light', customStyles: historyStyles }) %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <p class="text-uppercase small text-primary fw-semibold mb-1">Your orders</p>
      <h2 class="fw-bold mb-0">Purchase history</h2>
      <p class="text-muted small mb-0">View invoices, statuses, and items you have checked out.</p>
    </div>
    <a href="/shopping" class="btn btn-outline-primary">Continue shopping</a>
  </div>

  <% if (messages && messages.error && messages.error.length) { %>
    <div class="alert alert-danger rounded-3">
      <% messages.error.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (messages && messages.success && messages.success.length) { %>
    <div class="alert alert-success rounded-3">
      <% messages.success.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <% if (!orders.length) { %>
    <div class="alert alert-info rounded-3">
      You have no orders yet. <a href="/shopping" class="alert-link">Start shopping</a> to fill your cart.
    </div>
  <% } else { %>
    <div class="row g-4">
      <% orders.forEach(function(order) { %>
        <div class="col-12">
          <div class="card order-card">
            <div class="card-body">
              <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                  <div class="fw-bold">Order</div>
                  <small class="text-muted">Placed on <%= new Date(order.created_at).toLocaleString() %></small>
                </div>
                <div class="text-end">
                  <div class="badge bg-primary status-badge"><%= order.status %></div>
                  <div class="fw-bold fs-5 mt-1">$<%= Number(order.total_amount).toFixed(2) %></div>
                  <small class="text-muted"><%= formatPaymentLabel(order) %></small>
                  <div class="mt-2">
                    <a href="/orders/<%= order.id %>/invoice" class="btn btn-sm btn-outline-secondary">View / Print invoice</a>
                  </div>
                  <div class="mt-2">
                    <% if (order.refund_status) { %>
                      <% const refundClass = order.refund_status === 'approved' ? 'bg-success' : order.refund_status === 'denied' ? 'bg-danger' : 'bg-warning text-dark'; %>
                      <span class="badge <%= refundClass %> text-uppercase">Refund: <%= order.refund_status %></span>
                      <% if (order.refund_status === 'denied' && order.refund_admin_note) { %>
                        <div class="text-muted small mt-1">Admin feedback: <%= order.refund_admin_note %></div>
                      <% } %>
                    <% } else if (order.status === 'paid') { %>
                      <a href="/orders/<%= order.id %>/refund" class="btn btn-sm btn-outline-danger">Request refund</a>
                    <% } %>
                  </div>
                </div>
              </div>
              <div class="table-responsive">
                <table class="table table-sm align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>Product</th>
                      <th>Image</th>
                      <th>Qty</th>
                      <th>Price</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% const items = orderItems[order.id] || []; %>
                    <% items.forEach(function(item) { 
                        const displayName = item.productName || item.product_name_snapshot || 'Product';
                        const image = item.image || item.product_image_snapshot;
                    %>
                      <tr>
                        <td><%= displayName %></td>
                        <td>
                          <% if (image) { %>
                            <img src="<%= image.startsWith('http') ? image : '/images/' + image %>" alt="<%= displayName %>" width="60" class="img-thumbnail">
                          <% } else { %>
                            <span class="text-muted">No image</span>
                          <% } %>
                        </td>
                        <td><%= item.quantity %></td>
                        <td>$<%= Number(item.price_at_purchase).toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('partials/quickNav', { user, backToHref: '/shopping', backToLabel: 'Back to shop' }) %>
<%- include('partials/footer') %>
