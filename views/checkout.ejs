<%- include('partials/header', { pageTitle: 'Checkout', user }) %>

<style>
  .checkout-hero {
    background: radial-gradient(circle at top left, rgba(25, 118, 210, 0.15), transparent 55%),
                radial-gradient(circle at top right, rgba(0, 172, 193, 0.18), transparent 45%),
                #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .summary-card,
  .payment-card {
    border: 1px solid rgba(15, 23, 42, 0.08);
  }
  .payment-card {
    background: #ffffff;
  }
  .payment-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .payment-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.5px;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  .paypal-logo {
    background: #eef5ff;
    color: #003087;
    border: 1px solid rgba(0, 48, 135, 0.2);
  }
  .nets-logo {
    background: #fef3c7;
    color: #14532d;
    border: 1px solid rgba(20, 83, 45, 0.2);
  }
  .card-logo {
    background: #f3f4f6;
    color: #0f172a;
    border: 1px solid rgba(15, 23, 42, 0.12);
  }
  .logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: currentColor;
    display: inline-block;
  }
  .payment-note {
    color: #475569;
  }
  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #f8fafc;
    border: 1px dashed rgba(15, 23, 42, 0.15);
    font-size: 0.8rem;
    color: #475569;
  }
  .summary-item {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 12px;
    align-items: center;
  }
  .summary-thumb {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid rgba(15, 23, 42, 0.12);
    background: #f8fafc;
  }
  .summary-meta {
    line-height: 1.2;
  }
  .back-link {
    white-space: nowrap;
  }
  .auto-pay-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
  }
  .stripe-card-field {
    padding: 14px 12px;
    min-height: 54px;
  }
  .stripe-card-field.StripeElement--focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
  }
  .stripe-card-field.StripeElement--invalid {
    border-color: #dc3545;
  }
  .stripe-card-label {
    font-weight: 500;
    margin-bottom: 6px;
    display: block;
  }
</style>

<div class="container py-5">
  <div class="checkout-hero rounded-4 p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
      <div>
        <h2 class="mb-1">Checkout</h2>
        <p class="mb-0 text-muted">Review your order and choose a payment option.</p>
      </div>
      <div class="trust-row">
        <span class="trust-badge"><span class="logo-dot"></span>Secure checkout</span>
        <span class="trust-badge"><span class="logo-dot"></span>Instant confirmation</span>
        <span class="trust-badge"><span class="logo-dot"></span>Local payments</span>
        <a href="/cart" class="btn btn-outline-secondary btn-sm back-link">Back to cart</a>
      </div>
    </div>
  </div>

  <% if (messages && messages.error && messages.error.length) { %>
    <div class="alert alert-danger rounded-3">
      <% messages.error.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (messages && messages.success && messages.success.length) { %>
    <div class="alert alert-success rounded-3">
      <% messages.success.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card shadow-sm summary-card rounded-4">
        <div class="card-body">
          <h5 class="card-title">Order summary</h5>
          <ul class="list-group list-group-flush">
            <% cart.forEach(function(item) { %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div class="summary-item w-100">
                  <img
                    src="<%= item.image ? '/images/' + item.image : '/images/noImage.png' %>"
                    alt="<%= item.productName %>"
                    class="summary-thumb"
                    loading="lazy"
                  >
                  <div class="summary-meta">
                    <div class="fw-semibold"><%= item.productName %></div>
                    <small class="text-muted">Qty: <%= item.quantity %> x $<%= Number(item.price).toFixed(2) %></small>
                  </div>
                  <div class="fw-bold">$<%= (item.quantity * item.price).toFixed(2) %></div>
                </div>
              </li>
            <% }); %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span class="fw-bold">Total</span>
              <span class="fw-bold fs-5">$<%= total %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card shadow-sm payment-card rounded-4" id="paypal-section">
        <div class="card-body">
          <div class="payment-header mb-3">
            <h5 class="card-title mb-0">Pay with PayPal</h5>
            <span class="payment-logo paypal-logo">
              <span class="logo-dot"></span>
              PayPal
            </span>
          </div>
          <% if (paypalClientId) { %>
            <div id="paypal-button-container" class="mb-3"></div>
            <p class="small payment-note mb-0">Fast checkout using your PayPal account.</p>
          <% } else { %>
            <div class="alert alert-warning">PayPal is not configured. Add PAYPAL_CLIENT_ID to enable.</div>
          <% } %>
        </div>
      </div>

      <div class="card shadow-sm payment-card rounded-4 mt-4" id="nets-section">
        <div class="card-body d-grid gap-3">
          <div class="payment-header">
            <h5 class="card-title mb-0">Pay with NETS QR</h5>
            <span class="payment-logo nets-logo">
              <span class="logo-dot"></span>
              NETS
            </span>
          </div>
          <p class="small payment-note mb-1">Generate a NETS QR code for the cart total.</p>
          <form action="/payments/nets" method="POST" class="d-grid gap-2" id="nets-pay-form">
            <button type="submit" class="btn btn-success">Generate NETS QR</button>
            <div class="auto-pay-status text-success d-none" id="nets-auto-spinner">
              <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Starting NETS QR payment...
            </div>
          </form>
        </div>
      </div>

      <div class="card shadow-sm payment-card rounded-4 mt-4" id="card-section">
        <div class="card-body">
          <div class="payment-header mb-3">
            <h5 class="card-title mb-0">Pay with Credit/Debit Card</h5>
            <span class="payment-logo card-logo">
              <span class="logo-dot"></span>
              Cards
            </span>
          </div>
          <form action="/checkout" method="POST" class="d-grid gap-2">
            <input type="hidden" name="paymentMethod" value="card">
            <input type="hidden" name="paymentMethodId" id="paymentMethodId">
            <div class="form-floating">
              <input type="text" class="form-control" id="cardName" name="cardName" placeholder="Cardholder name" required>
              <label for="cardName">Cardholder name</label>
              <div class="invalid-feedback">Please enter the cardholder name.</div>
            </div>
            <div>
              <label class="stripe-card-label" for="stripe-card-element">Card details</label>
              <div id="stripe-card-element" class="form-control stripe-card-field"></div>
              <div class="invalid-feedback">Please enter valid card details.</div>
            </div>
            <button type="submit" class="btn btn-primary">Pay $<%= total %></button>
            <div class="text-danger small d-none" id="cardPaymentError"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/quickNav', { user, backToHref: '/cart', backToLabel: 'Back to cart' }) %>
<%- include('partials/footer') %>

<% if (paypalClientId) { %>
  <script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=SGD&intent=capture&disable-funding=card"></script>
  <script>
    (function initPayPal() {
      if (!window.paypal) return;
      paypal.Buttons({
        fundingSource: paypal.FUNDING.PAYPAL,
        style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'paypal' },
        createOrder: () => {
          return fetch('/payments/paypal/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          })
            .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
            .then(({ ok, data }) => {
              if (!ok || !data.id) {
                throw new Error(data.error || 'Unable to start PayPal checkout right now.');
              }
              return data.id;
            })
            .catch(() => {
              window.location.href = '/checkout/failure?method=paypal&reason=error';
            });
        },
        onApprove: (data) => {
          return fetch('/payments/paypal/capture', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: data.orderID })
          })
            .then((res) => res.json().then((result) => ({ ok: res.ok, result })))
            .then(({ ok, result }) => {
              if (result && result.redirectUrl) {
                window.location.href = result.redirectUrl;
                return;
              }
              if (!ok) {
                window.location.href = '/checkout/failure?method=paypal&reason=error';
                return;
              }
              alert(result?.error || 'Unable to finalize PayPal payment.');
            })
            .catch(() => {
              window.location.href = '/checkout/failure?method=paypal&reason=error';
            });
        },
        onError: () => window.location.href = '/checkout/failure?method=paypal&reason=error',
        onCancel: () => window.location.href = '/checkout/failure?method=paypal&reason=cancelled'
      }).render('#paypal-button-container');
    })();
  </script>
<% } %>

<% if (stripePublishableKey) { %>
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    window.__stripePublishableKey = "<%= stripePublishableKey %>";
  </script>
<% } %>

<script>
  (function autoPayHelper() {
    const params = new URLSearchParams(window.location.search);
    const method = (params.get('autoPay') || '').toLowerCase();
    if (!method) return;

    const focusSection = (id) => {
      const section = document.getElementById(id);
      if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    if (method === 'nets') {
      focusSection('nets-section');
      const form = document.getElementById('nets-pay-form');
      const spinner = document.getElementById('nets-auto-spinner');
      if (form) {
        const btn = form.querySelector('button[type="submit"]');
        if (spinner) spinner.classList.remove('d-none');
        if (btn) btn.disabled = true;
        setTimeout(() => form.submit(), 700);
      }
    } else if (method === 'paypal') {
      focusSection('paypal-section');
    } else if (method === 'card') {
      focusSection('card-section');
      const input = document.getElementById('cardName');
      if (input) {
        setTimeout(() => input.focus(), 400);
      }
    }
  })();
</script>

<script>
  (function cardInputHelpers() {
    const cardForm = document.querySelector('#card-section form');
    if (!cardForm) return;
    const cardName = document.getElementById('cardName');
    const errorEl = document.getElementById('cardPaymentError');
    const paymentMethodInput = document.getElementById('paymentMethodId');
    const stripeKey = window.__stripePublishableKey;

    const showError = (message) => {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.classList.remove('d-none');
    };
    const clearError = () => {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.classList.add('d-none');
    };

    if (!stripeKey || !window.Stripe) {
      showError('Stripe is not configured. Please try again later.');
      return;
    }

    const stripe = Stripe(stripeKey);
    const elements = stripe.elements();
    const card = elements.create('card', {
      hidePostalCode: true,
      style: {
        base: {
          fontSize: '16px',
          color: '#0f172a',
          '::placeholder': { color: '#94a3b8' }
        }
      }
    });
    card.mount('#stripe-card-element');

    cardForm.addEventListener('submit', (event) => {
      clearError();
      const hasErrors = !cardName.value.trim();

      if (hasErrors) {
        event.preventDefault();
        showError('Please enter the cardholder name.');
        return;
      }

      if (!paymentMethodInput || !paymentMethodInput.value) {
        event.preventDefault();
        stripe.createPaymentMethod({
          type: 'card',
          card: card,
          billing_details: { name: cardName.value.trim() }
        }).then((result) => {
          if (result.error) {
            showError(result.error.message || 'Unable to process card details.');
            return;
          }
          paymentMethodInput.value = result.paymentMethod.id;
          cardForm.submit();
        });
      }

    });
  })();
</script>
