<%- include('partials/header', { pageTitle: 'Checkout', user }) %>

<div class="container py-5">
  <h2 class="mb-4">Checkout</h2>

  <% if (messages && messages.error && messages.error.length) { %>
    <div class="alert alert-danger rounded-3">
      <% messages.error.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (messages && messages.success && messages.success.length) { %>
    <div class="alert alert-success rounded-3">
      <% messages.success.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Order summary</h5>
          <ul class="list-group list-group-flush">
            <% cart.forEach(function(item) { %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-semibold"><%= item.productName %></div>
                  <small class="text-muted">Qty: <%= item.quantity %> x $<%= Number(item.price).toFixed(2) %></small>
                </div>
                <div class="fw-bold">$<%= (item.quantity * item.price).toFixed(2) %></div>
              </li>
            <% }); %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span class="fw-bold">Total</span>
              <span class="fw-bold fs-5">$<%= total %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Pay with PayPal (Sandbox)</h5>
          <% if (paypalClientId) { %>
            <div id="paypal-button-container" class="mb-3"></div>
            <p class="small text-muted mb-0">Use your sandbox PayPal account to complete payment.</p>
          <% } else { %>
            <div class="alert alert-warning">PayPal is not configured. Add PAYPAL_CLIENT_ID to enable.</div>
          <% } %>
        </div>
      </div>

      <div class="card shadow-sm mt-4">
        <div class="card-body d-grid gap-3">
          <h5 class="card-title">Pay with NETS QR (Sandbox)</h5>
          <p class="small text-muted mb-1">We will generate a sandbox NETS QR for the cart total.</p>
          <form action="/payments/nets" method="POST" class="d-grid gap-2">
            <button type="submit" class="btn btn-danger">Generate NETS QR</button>
          </form>
        </div>
      </div>

      <div class="card shadow-sm mt-4">
        <div class="card-body">
          <h5 class="card-title">Pay with Credit/Debit Card</h5>
          <form action="/checkout" method="POST" class="d-grid gap-2">
            <input type="hidden" name="paymentMethod" value="card">
            <div class="form-floating">
              <input type="text" class="form-control" id="cardName" name="cardName" placeholder="Cardholder name" required>
              <label for="cardName">Cardholder name</label>
            </div>
            <div class="form-floating">
              <input type="text" class="form-control" id="cardNumber" name="cardNumber" placeholder="0000 0000 0000 0000" maxlength="23" required inputmode="numeric" autocomplete="cc-number">
              <label for="cardNumber">Card number</label>
            </div>
            <div class="row g-2">
              <div class="col-6">
                <div class="form-floating">
                  <input type="text" class="form-control" id="expiry" name="expiry" placeholder="MM/YY" maxlength="5" required inputmode="numeric" autocomplete="cc-exp">
                  <label for="expiry">Expiry (MM/YY)</label>
                </div>
              </div>
              <div class="col-6">
                <div class="form-floating">
                  <input type="text" class="form-control" id="cvv" name="cvv" placeholder="123" maxlength="4" required inputmode="numeric" autocomplete="cc-csc">
                  <label for="cvv">CVV</label>
                </div>
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Pay $<%= total %></button>
            <a href="/cart" class="btn btn-outline-secondary">Back to cart</a>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/quickNav', { user, backToHref: '/cart', backToLabel: 'Back to cart' }) %>
<%- include('partials/footer') %>

<% if (paypalClientId) { %>
  <script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=SGD&intent=capture&disable-funding=card"></script>
  <script>
    (function initPayPal() {
      if (!window.paypal) return;
      paypal.Buttons({
        fundingSource: paypal.FUNDING.PAYPAL,
        style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'paypal' },
        createOrder: () => {
          return fetch('/payments/paypal/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          })
            .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
            .then(({ ok, data }) => {
              if (!ok || !data.id) {
                throw new Error(data.error || 'Unable to start PayPal checkout right now.');
              }
              return data.id;
            })
            .catch(() => {
              alert('Unable to start PayPal checkout right now.');
            });
        },
        onApprove: (data) => {
          return fetch('/payments/paypal/capture', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: data.orderID })
          })
            .then((res) => res.json().then((result) => ({ ok: res.ok, result })))
            .then(({ ok, result }) => {
              if (ok && result && result.redirectUrl) {
                window.location.href = result.redirectUrl;
                return;
              }
              alert(result?.error || 'Unable to finalize PayPal payment.');
            })
            .catch(() => {
              alert('Unable to finalize PayPal payment.');
            });
        },
        onError: () => alert('Unable to process PayPal payment. Please try again.'),
        onCancel: () => window.location.reload()
      }).render('#paypal-button-container');
    })();
  </script>
<% } %>
