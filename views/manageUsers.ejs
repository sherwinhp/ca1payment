<%
  const manageStyles = `
    body {
      background: #0b1220;
      color: #e2e8f0;
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    }
    .admin-hero {
      background: linear-gradient(135deg, #8b5cf6, #0ea5e9);
      border-radius: 22px;
      color: #fff;
      box-shadow: 0 25px 45px rgba(0,0,0,0.24);
    }
    .admin-card {
      border: none;
      border-radius: 16px;
      background: rgba(255,255,255,0.04);
      color: #e2e8f0;
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
      backdrop-filter: blur(6px);
    }
    .form-control, .form-select {
      border-radius: 12px;
      padding: 0.75rem;
      background: rgba(255,255,255,0.9);
    }
    .btn-primary {
      border-radius: 12px;
      padding: 0.65rem 1.25rem;
      font-weight: 700;
      background: #0ea5e9;
      border-color: #0ea5e9;
    }
    .btn-primary:hover {
      background: #0284c7;
      border-color: #0284c7;
    }
    .btn-outline-danger, .btn-outline-primary, .btn-outline-warning {
      border-radius: 10px;
    }
    .table thead th {
      border-bottom: 1px solid rgba(255,255,255,0.08);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.8rem;
      color: #94a3b8;
    }
    .table > :not(caption) > * > * {
      border-color: rgba(255,255,255,0.08);
      vertical-align: middle;
      color: #e2e8f0;
      background-color: transparent !important;
    }
    .table {
      background: rgba(255,255,255,0.03);
      color: #e2e8f0;
    }
    .table-hover tbody tr,
    .table-striped tbody tr:nth-of-type(odd) {
      background: rgba(255,255,255,0.02);
    }
    .table-hover tbody tr:hover {
      background: rgba(255,255,255,0.06);
    }
    .table a {
      color: #7dd3fc;
    }
    .table a:hover {
      color: #bae6fd;
    }
  `;
%>
<%- include('partials/header', { pageTitle: 'Manage Users', user, customStyles: manageStyles, bodyClass: 'bg-dark' }) %>

<div class="container py-4">
  <div class="admin-hero p-4 p-lg-5 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <p class="text-uppercase small mb-2" style="letter-spacing: 0.2rem;">Admin</p>
      <h1 class="fw-bold mb-2">Manage user roles</h1>
      <p class="mb-0">Create shoppers, promote admins, and keep accounts in sync.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/inventory" class="btn btn-light text-dark">Back to inventory</a>
      <a href="/admin/orders" class="btn btn-outline-light">View orders</a>
    </div>
  </div>

  <% const userForm = formData || {}; %>

  <% if (messages && messages.success && messages.success.length) { %>
    <div class="alert alert-success admin-card">
      <% messages.success.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <% if (messages && messages.error && messages.error.length) { %>
    <div class="alert alert-danger admin-card">
      <% messages.error.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <div class="card admin-card mb-4">
    <div class="card-body">
      <h5 class="card-title mb-2">Add a new account</h5>
      <p class="text-muted small mb-3">Admins can create shopper or admin accounts. Passwords must be at least 6 characters.</p>
      <form action="/admin/users" method="POST" class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="newUsername">Username</label>
          <input type="text" id="newUsername" name="username" class="form-control" required value="<%= userForm.username || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="newEmail">Email</label>
          <input type="email" id="newEmail" name="email" class="form-control" required value="<%= userForm.email || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="newPassword">Password</label>
          <input type="password" id="newPassword" name="password" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="newRole">Role</label>
          <select id="newRole" name="role" class="form-select">
            <option value="user" <%= userForm.role === 'admin' ? '' : 'selected' %>>Shopper</option>
            <option value="admin" <%= userForm.role === 'admin' ? 'selected' : '' %>>Admin</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="newAddress">Address</label>
          <input type="text" id="newAddress" name="address" class="form-control" required value="<%= userForm.address || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="newContact">Contact Number</label>
          <input type="text" id="newContact" name="contact" class="form-control" required value="<%= userForm.contact || '' %>">
        </div>
        <div class="col-12 d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">Create account</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card admin-card">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">All users</h5>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Actions</th>
              <th>Delete</th>
            </tr>
          </thead>
          <tbody>
            <% if (!users.length) { %>
              <tr>
                <td colspan="6" class="text-center text-muted">No users found.</td>
              </tr>
            <% } %>
            <% users.forEach(function(account, index) { 
                 const isPrimary = account.email === primaryAdminEmail;
                 const isSelf = account.id === user.id;
            %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= account.username %></td>
                <td><%= account.email %></td>
                <td>
                  <% if (isPrimary) { %>
                    <span class="badge bg-warning text-dark">Primary Admin</span>
                  <% } else if (account.role === 'admin') { %>
                    <span class="badge bg-success">Admin</span>
                  <% } else { %>
                    <span class="badge bg-secondary">User</span>
                  <% } %>
                </td>
                <td>
                  <% if (isPrimary) { %>
                    <span class="text-muted small">This admin cannot be modified.</span>
                  <% } else if (account.role === 'admin') { %>
                    <% if (isSelf) { %>
                      <span class="text-muted small">Signed-in admin</span>
                    <% } else { %>
                      <form action="/admin/users/<%= account.id %>/demote" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-warning">Demote to user</button>
                      </form>
                    <% } %>
                  <% } else { %>
                    <form action="/admin/users/<%= account.id %>/promote" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-primary">Promote to admin</button>
                    </form>
                  <% } %>
                </td>
                <td>
                  <% if (isPrimary) { %>
                    <span class="text-muted small">Protected</span>
                  <% } else if (isSelf) { %>
                    <span class="text-muted small">Signed-in account</span>
                  <% } else { %>
                    <form action="/admin/users/<%= account.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this account? This cannot be undone.');">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/quickNav', { user, backToHref: '/inventory', backToLabel: 'Back to inventory' }) %>
<%- include('partials/footer') %>
