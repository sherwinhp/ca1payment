<%
  const shoppingStyles = `
    body {
      background-color: #f4f6fb;
      color: #0f172a;
    }
    .shop-hero {
      background: linear-gradient(120deg, #1f8a70, #4cc9b4);
      border-radius: 28px;
      color: white;
    }
    .product-card {
      border: none;
      border-radius: 22px;
      box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08);
      height: 100%;
    }
    .product-card img {
      object-fit: cover;
      border-radius: 16px;
    }
    .rating-stars span {
      color: #f6c343;
      font-size: 0.95rem;
    }
  `;
%>
<%- include('partials/header', { pageTitle: 'Shop Fresh Produce', bodyClass: 'bg-light', user, customStyles: shoppingStyles }) %>

  <div class="container py-5">
    <% const productList = Array.isArray(products) ? products : []; %>
    <% const currentUser = user || null; %>
    <% const isGuest = !currentUser; %>
    <% const canBuy = currentUser && currentUser.role === 'user'; %>
    <% if (messages && messages.success && messages.success.length) { %>
      <div class="alert alert-success">
        <% messages.success.forEach(function(msg) { %><div><%= msg %></div><% }); %>
      </div>
    <% } %>
    <% if (messages && messages.error && messages.error.length) { %>
      <div class="alert alert-danger">
        <% messages.error.forEach(function(msg) { %><div><%= msg %></div><% }); %>
      </div>
    <% } %>
    <section class="shop-hero p-4 p-lg-5 mb-5">
      <div class="row align-items-center gy-3">
        <div class="col-lg-8">
          <p class="text-uppercase small mb-1" style="letter-spacing: 0.25rem;">Weekly picks</p>
          <h1 class="display-6 fw-bold mb-3">Browse fresh produce and add favourites to your cart.</h1>
          <p class="mb-0">Tap any card to view full details. You can add straight to cart, or open the product page to see reviews.</p>
        </div>
        <div class="col-lg-4 text-lg-end text-center">
          <% if (currentUser) { %>
            <p class="mb-1">Signed in as <strong><%= currentUser.username %></strong></p>
            <span class="badge bg-light text-dark text-uppercase fw-semibold"><%= currentUser.role %></span>
          <% } else { %>
            <p class="mb-2">Browsing as guest.</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
              <a href="/login" class="btn btn-sm btn-outline-light">Log in</a>
              <a href="/register" class="btn btn-sm btn-light text-dark">Log in or create an account</a>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <% const hasShoppingError = typeof shoppingError !== 'undefined' ? shoppingError : null; %>
    <% if (hasShoppingError) { %>
      <div class="alert alert-warning rounded-4"><%= hasShoppingError %></div>
    <% } %>

    <div class="row g-4">
      <% productList.forEach((product) => {
          const ratingValue = parseFloat(product.averageRating) || 0;
          const reviewCopy = product.reviewCount ? `${product.reviewCount} reviews` : 'No reviews yet';
          const productImage = product.image ? `/images/${product.image}` : 'https://images.unsplash.com/photo-1506807803488-8eafc15323c2?auto=format&fit=crop&w=600&q=80';
          const stockCount = Number(product.quantity) || 0;
          const status = product.status || (stockCount <= 0 ? 'sold_out' : stockCount < 10 ? 'low_stock' : 'in_stock');
          const isLowStock = status === 'low_stock' && stockCount > 0;
          const isSoldOut = status === 'sold_out' || stockCount <= 0;
          const canPurchase = canBuy && !isSoldOut;
      %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card product-card">
            <div class="card-body d-flex flex-column gap-3">
              <a href="/product/<%= product.id %>" class="ratio ratio-4x3">
                <img src="<%= productImage %>" alt="<%= product.productName %> photo" class="w-100 h-100">
              </a>
              <div>
                <h5 class="fw-bold mb-1"><%= product.productName %></h5>
                <p class="text-muted mb-2"><%= product.shortDescription || product.friendlyDescription || 'Fresh produce ready for you.' %></p>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <div class="rating-stars">
                    <% for (let i = 0; i < Math.round(ratingValue); i++) { %>
                      <span>&#9733;</span>
                    <% } %>
                    <% for (let i = Math.round(ratingValue); i < 5; i++) { %>
                      <span class="text-secondary">&#9734;</span>
                    <% } %>
                  </div>
                  <small class="text-muted">
                    <%= ratingValue ? ratingValue.toFixed(1) : 'New' %> - <%= reviewCopy %>
                  </small>
                </div>
              </div>
              <div class="d-flex align-items-baseline justify-content-between">
                <span class="fs-4 fw-bold">$<%= Number(product.price).toFixed(2) %></span>
                <small class="text-muted">
                  <% if (isSoldOut) { %>
                    Sold out
                  <% } else if (isLowStock) { %>
                    Low stock: <%= stockCount %> left
                  <% } else { %>
                    Stock: <%= stockCount %>
                  <% } %>
                </small>
              </div>
              <% if (canPurchase) { %>
                <form action="/add-to-cart/<%= product.id %>" method="POST" class="d-flex gap-2">
                  <% const maxQty = Math.max(1, stockCount); %>
                  <select name="quantity" class="form-select w-auto">
                    <% for (let q = 1; q <= maxQty; q++) { %>
                      <option value="<%= q %>"><%= q %> pcs</option>
                    <% } %>
                  </select>
                  <small class="text-muted align-self-center">Max <%= maxQty %></small>
                  <button type="submit" class="btn btn-primary flex-grow-1">Add to cart</button>
                </form>
              <% } else if (isGuest) { %>
                <div class="d-grid gap-2">
                  <a href="/login" class="btn btn-primary">Log in or create an account</a>
                  <a href="/register" class="btn btn-outline-secondary">Create an account</a>
                </div>
              <% } else if (currentUser && currentUser.role !== 'user') { %>
                <button class="btn btn-secondary w-100" disabled>Admins cannot add items to cart</button>
              <% } else { %>
                <button class="btn btn-secondary w-100" disabled>Out of stock</button>
              <% } %>
              <a href="/product/<%= product.id %>" class="btn btn-outline-dark w-100">View product page</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <%- include('partials/quickNav', { user, backToHref: '/', backToLabel: 'Back to home' }) %>
<%- include('partials/footer') %>
