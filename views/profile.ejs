<%- include('partials/header', { pageTitle: 'Your Profile', bodyClass: 'bg-light', user }) %>

<div class="container py-5" style="max-width: 720px;">
  <h1 class="mb-4">Profile</h1>
  <p class="text-muted">Update your personal details. Leave the password blank to keep your current password.</p>

  <% const formValues = formData || user || {}; %>

  <% if (messages && messages.success && messages.success.length) { %>
    <div class="alert alert-success">
      <% messages.success.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <% if (messages && messages.errors && messages.errors.length) { %>
    <div class="alert alert-danger">
      <% messages.errors.forEach(function(msg) { %>
        <div><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <form action="/profile" method="POST" class="card p-4 shadow-sm">
    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input type="text" class="form-control" id="username" name="username" required value="<%= formValues.username || '' %>">
    </div>
    <div class="mb-3">
      <label for="email" class="form-label">Email</label>
      <input type="email" class="form-control" id="email" name="email" required value="<%= formValues.email || '' %>">
    </div>
    <div class="mb-3">
      <label for="address" class="form-label">Address</label>
      <input type="text" class="form-control" id="address" name="address" required value="<%= formValues.address || '' %>">
    </div>
    <div class="mb-3">
      <label for="contact" class="form-label">Contact Number</label>
      <input type="text" class="form-control" id="contact" name="contact" required value="<%= formValues.contact || '' %>">
    </div>
    <div class="mb-4">
      <label for="password" class="form-label">New Password (optional)</label>
      <input type="password" class="form-control" id="password" name="password" placeholder="Leave blank to keep existing password">
      <small class="text-muted">Minimum 6 characters if you wish to change your password.</small>
    </div>
    <div class="d-flex justify-content-between align-items-center">
      <a href="/" class="btn btn-outline-secondary">Back to home</a>
      <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
