<%- include('partials/header', { pageTitle: 'Inventory', user }) %>

<div class="container">
  <p class="mt-3">Welcome, <%= user.username %> (<%= user.role %>)</p>
  <div class="text-center">
    <h2>Products from Supermarket App Database</h2>
  </div>
  <table class="table table-hover small text-center mt-4">
    <thead>
      <tr>
        <th width="100">Product Name</th>
        <th width="100">Product Image</th>
        <th width="50">Quantity</th>
        <th width="50">Price</th>
        <th width="80">Status</th>
        <th width="50">Edit</th>
        <th width="50">Delete</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function(product) { %>
        <tr>
          <td><a href="/product/<%= product.id %>"><%= product.productName %></a></td>
          <td><img src="/images/<%= product.image %>" width="20%" alt="<%= product.productName %>"></td>
          <td><%= product.quantity %></td>
          <td>$<%= Number(product.price).toFixed(2) %></td>
          <% const status = product.status || (Number(product.quantity) > 0 ? 'in_stock' : 'sold_out'); %>
          <td>
            <% if (status === 'sold_out') { %>
              <span class="badge bg-danger">Sold out</span>
            <% } else { %>
              <span class="badge bg-success">In stock</span>
            <% } %>
          </td>
          <td><a href="/updateProduct/<%= product.id %>">Edit</a></td>
          <td>
            <a href="/deleteProduct/<%= product.id %>" onclick="return confirm('Are you sure you want to delete this product?')">
              Delete
            </a>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('partials/quickNav', { user, backToHref: '/', backToLabel: 'Back to home' }) %>
<%- include('partials/footer') %>
