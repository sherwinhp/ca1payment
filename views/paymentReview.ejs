<%- include('partials/header', {
  pageTitle: title || 'Payment Under Review',
  user,
  bodyClass: 'payment-review-page',
  extraHead: `
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  `,
  customStyles: `
    :root {
      --review-ink: #0f172a;
      --review-muted: #475569;
      --review-accent: #f59e0b;
      --review-accent-soft: #fef3c7;
      --review-card: #ffffff;
      --review-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
    }
    body.payment-review-page {
      font-family: "Work Sans", "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top, rgba(245, 158, 11, 0.18), transparent 55%),
        linear-gradient(180deg, #fff7ed 0%, #f8fafc 100%);
      color: var(--review-ink);
    }
    .payment-review-wrap {
      min-height: calc(100vh - 140px);
      display: flex;
      align-items: center;
    }
    .payment-review-card {
      border: 0;
      border-radius: 22px;
      box-shadow: var(--review-shadow);
      background: var(--review-card);
    }
    .review-title {
      font-family: "Space Grotesk", "Segoe UI", sans-serif;
      letter-spacing: -0.02em;
    }
    .review-icon {
      width: 62px;
      height: 62px;
      border-radius: 999px;
      background: linear-gradient(140deg, #f59e0b 0%, #d97706 100%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      box-shadow: 0 12px 30px rgba(245, 158, 11, 0.25);
    }
    .review-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      background: var(--review-accent-soft);
      color: var(--review-accent);
      font-weight: 600;
      font-size: 0.9rem;
    }
    .review-note {
      color: var(--review-muted);
    }
    .review-info {
      background: #f8fafc;
      border: 1px solid rgba(148, 163, 184, 0.2);
      border-radius: 16px;
      padding: 16px;
    }
    .review-info-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #64748b;
      margin-bottom: 4px;
    }
    .review-info-value {
      font-weight: 700;
      color: #0f172a;
    }
    .action-btn {
      border-radius: 14px;
      font-weight: 600;
      padding: 12px 16px;
    }
  `
}) %>

<%
  const methodLower = String(method || order?.payment_method || '').toLowerCase();
  let methodLabel = 'payment';
  if (methodLower === 'paypal') methodLabel = 'PayPal';
  if (methodLower === 'nets') methodLabel = 'NETS QR';
  if (methodLower === 'card') methodLabel = 'card';
%>

<div class="container payment-review-wrap py-5">
  <div class="payment-review-card mx-auto w-100" style="max-width: 700px;">
    <div class="card-body p-4 p-md-5">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
          <div class="review-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 8v4l2.5 2.5" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="9" stroke="white" stroke-width="2.5"/>
            </svg>
          </div>
          <div>
            <div class="text-uppercase small fw-semibold text-muted">Under review</div>
            <h2 class="review-title mb-0">Payment under review</h2>
          </div>
        </div>
        <span class="review-pill text-uppercase">Pending</span>
      </div>

      <p class="review-note mb-4">
        Your <%= methodLabel %> payment has been received and is currently under manual review. We’ll update your order once it’s approved.
      </p>

      <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
          <div class="review-info">
            <div class="review-info-label">Order ID</div>
            <div class="review-info-value">#<%= order.id %></div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="review-info">
            <div class="review-info-label">Total paid</div>
            <div class="review-info-value">$<%= Number(order.total_amount || 0).toFixed(2) %></div>
          </div>
        </div>
      </div>

      <div class="d-grid gap-2 d-md-flex mt-2">
        <a href="/orders" class="btn btn-warning action-btn flex-fill">View order history</a>
        <a href="/shopping" class="btn btn-outline-dark action-btn flex-fill">Continue shopping</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
