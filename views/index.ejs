<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
  <style>
    :root {
      --brand-green: #1f8a70;
      --brand-cream: #f6f7eb;
      --brand-orange: #f75c03;
    }
    body {
      background-color: #f4f6fb;
      color: #0f172a;
    }
    .letter-spacing-3 {
      letter-spacing: 0.3rem;
    }
    .hero-panel {
      background: linear-gradient(120deg, var(--brand-green), #4cc9b4);
      border-radius: 32px;
      color: #fff;
    }
    .hero-panel .btn {
      padding: 0.85rem 1.75rem;
      font-weight: 600;
      border-radius: 999px;
    }
    .hero-badges span {
      background-color: rgba(255,255,255,0.2);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      font-size: 0.85rem;
    }
    .product-card img {
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .product-card:hover img {
      transform: scale(1.05);
    }
    .product-card {
      border: none;
      border-radius: 24px;
    }
    .product-card .card-body {
      display: flex;
      flex-direction: column;
    }
    .rating-stars span {
      font-size: 0.9rem;
      color: #f6c343;
    }
    .badge-soft-success {
      background-color: rgba(31, 138, 112, 0.12);
      color: var(--brand-green);
      border: 1px solid rgba(31, 138, 112, 0.2);
    }
    .info-tile {
      border-radius: 20px;
      background-color: #fff;
      box-shadow: 0 25px 45px rgba(15, 23, 42, 0.08);
      padding: 1.5rem;
      height: 100%;
    }
    .info-tile h5 {
      font-weight: 700;
    }
    .highlight-chip {
      font-size: 0.75rem;
      text-transform: uppercase;
      background-color: rgba(15, 23, 42, 0.08);
      border-radius: 999px;
      padding: 0.25rem 0.75rem;
      letter-spacing: 0.08em;
    }
  </style>
</head>
<body class="bg-light">
    <% const isLoggedIn = !!user; %>
    <% const featured = Array.isArray(featuredProducts) ? featuredProducts : []; %>
    <% const hero = heroCopy || {}; %>
    <% const heroHeading = hero.heading || 'Farm-fresh goodness delivered daily'; %>
    <% const heroSubheading = hero.subheading || 'Discover produce with transparent ratings, curated descriptions, and effortless checkout.'; %>
    <% const heroPerks = Array.isArray(hero.perks) ? hero.perks : []; %>
    <% const alertMessages = Array.isArray(alerts) ? alerts : []; %>
    <% const heroPrimaryHref = isLoggedIn ? (user.role === 'admin' ? '/inventory' : '/shopping') : '/register'; %>
    <% const heroPrimaryLabel = isLoggedIn ? (user.role === 'admin' ? 'Manage Inventory' : 'Continue Shopping') : 'Join Supermarket Club'; %>
    <% const heroSecondaryHref = isLoggedIn ? (user.role === 'admin' ? '/shopping' : '/cart') : '/login'; %>
    <% const heroSecondaryLabel = isLoggedIn ? (user.role === 'admin' ? 'Preview Storefront' : 'View Cart') : 'Sign in to Shop'; %>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand fw-semibold" href="/">Supermarket App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav ms-auto">
            <% if (!isLoggedIn) { %>
                <li class="nav-item">
                    <a class="nav-link" href="/register">Register</a>
                </li> 
                <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                </li> 
            <% } else { %>
                <% if (user.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/inventory">Inventory</a>
                    </li> 
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/shopping">Shop All</a>
                    </li> 
                    <li class="nav-item">
                        <a class="nav-link" href="/cart">Cart</a>
                    </li> 
                <% } %>
                <li class="nav-item">
                    <a class="nav-link" href="/logout">Logout</a>
                </li> 
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <header class="container my-5">
      <div class="hero-panel p-5 shadow-lg position-relative overflow-hidden">
        <div class="row align-items-center gy-4">
          <div class="col-lg-7">
            <p class="text-uppercase mb-3 fw-semibold letter-spacing-3" style="opacity:0.85;">Curated weekly picks</p>
            <h1 class="display-5 fw-bold"><%= heroHeading %></h1>
            <p class="lead mt-3 mb-4"><%= heroSubheading %></p>
            <p class="mb-4">
              <% if (isLoggedIn) { %>
                Welcome back, <span class="fw-bold"><%= user.username %></span>!
                <%= user.role === 'admin'
                  ? 'Keep your digital shelves updated and preview what shoppers experience.'
                  : 'Add fruits to your cart, explore tasting notes, and read trusted 1-5 star reviews.' %>
              <% } else { %>
                Create an account to add fruits to your cart, view descriptions, and leave verified reviews.
              <% } %>
            </p>
            <div class="d-flex flex-wrap gap-3 mb-3">
              <a class="btn btn-light text-dark" href="<%= heroPrimaryHref %>"><%= heroPrimaryLabel %></a>
              <a class="btn btn-outline-light" href="<%= heroSecondaryHref %>"><%= heroSecondaryLabel %></a>
            </div>
            <% if (heroPerks.length) { %>
              <div class="hero-badges d-flex flex-wrap gap-2">
                <% heroPerks.forEach((perk) => { %>
                  <span><%= perk %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
          <div class="col-lg-5 text-lg-end text-center">
            <img src="https://images.unsplash.com/photo-1502740479091-635887520276?auto=format&fit=crop&w=600&q=80" class="img-fluid rounded-4 shadow" alt="Fresh produce assortment">
          </div>
        </div>
      </div>
    </header>

    <main class="container pb-5">
      <% alertMessages.forEach((message) => { %>
        <div class="alert alert-warning rounded-4 mb-4"><%= message %></div>
      <% }) %>

      <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
        <div>
          <p class="text-uppercase text-primary fw-semibold small mb-1">Weekly highlights</p>
          <h2 class="fw-bold mb-0">Featured fruits ready for checkout</h2>
        </div>
        <div class="ms-auto">
          <a href="<%= isLoggedIn ? '/shopping' : '/login' %>" class="btn btn-outline-primary rounded-pill">
            Browse all produce
          </a>
        </div>
      </div>

      <% if (!featured.length && !alertMessages.length) { %>
        <div class="alert alert-info rounded-4">No featured produce yet. Admins can add items from the inventory dashboard.</div>
      <% } %>

      <div class="row g-4">
        <% featured.forEach((product) => { 
            const ratingValue = typeof product.ratingValue === 'number'
              ? Math.min(5, Math.max(0, product.ratingValue))
              : (parseFloat(product.averageRating) || 0);
            const filledStars = Math.floor(ratingValue);
            const hasHalfStar = ratingValue - filledStars >= 0.5;
            const emptyStars = 5 - filledStars - (hasHalfStar ? 1 : 0);
            const reviewCopy = product.reviewCount > 0 ? `${product.reviewCount} reviews` : 'Be the first to review';
            const descriptionCopy = product.shortDescription || (product.productName ? `Handpicked ${product.productName.toLowerCase()} ready for your basket.` : 'Fresh produce ready for you.');
            const productImage = product.image ? `/images/${product.image}` : 'https://images.unsplash.com/photo-1506807803488-8eafc15323c2?auto=format&fit=crop&w=600&q=80';
            const detailHref = isLoggedIn ? `/product/${product.id}` : '/login';
            const detailLabel = isLoggedIn ? 'View details & reviews' : 'Sign in to view reviews';
            const canPurchase = isLoggedIn && user.role === 'user' && Number(product.quantity) > 0;
            const quantityCap = Math.max(1, Math.min(Number(product.quantity) || 5, 5));
            const highlights = Array.isArray(product.highlights) ? product.highlights.slice(0, 2) : [];
          %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="card product-card h-100 shadow-sm">
              <div class="p-3 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                  <span class="highlight-chip"><%= product.showcaseTag || 'Fresh pick' %></span>
                  <span class="badge badge-soft-success px-3 py-2 fw-semibold">
                    In stock: <%= product.quantity %>
                  </span>
                </div>
                <div class="ratio ratio-4x3 rounded-4 overflow-hidden bg-light mt-3">
                  <img src="<%= productImage %>" alt="<%= product.productName %> photo" class="w-100 h-100">
                </div>
              </div>
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                  <div>
                    <h5 class="fw-bold mb-0"><%= product.productName %></h5>
                    <% if (highlights.length) { %>
                      <p class="text-muted small mb-0"><%= highlights.join(' &middot; ') %></p>
                    <% } else { %>
                      <p class="text-muted small mb-0">Sustainably sourced</p>
                    <% } %>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                  <div class="rating-stars">
                    <% for (let i = 0; i < filledStars; i++) { %>
                      <span>&#9733;</span>
                    <% } %>
                    <% if (hasHalfStar) { %>
                      <span>&#9733;</span>
                    <% } %>
                    <% for (let i = 0; i < emptyStars; i++) { %>
                      <span class="text-secondary">&#9734;</span>
                    <% } %>
                  </div>
                  <span class="text-muted small">
                    <%= ratingValue ? ratingValue.toFixed(1) : 'New' %> &middot; <%= reviewCopy %>
                  </span>
                </div>
                <p class="text-muted flex-grow-1"><%= descriptionCopy %></p>
                <div class="d-flex align-items-baseline justify-content-between mb-3">
                  <div class="fw-bold fs-4">$<%= product.priceLabel || Number(product.price || 0).toFixed(2) %></div>
                  <span class="text-secondary small">per pack</span>
                </div>
                <% if (canPurchase) { %>
                  <form action="/add-to-cart/<%= product.id %>" method="POST" class="d-flex align-items-center gap-2 mb-2">
                    <select class="form-select w-auto" name="quantity">
                      <% for (let q = 1; q <= quantityCap; q++) { %>
                        <option value="<%= q %>"><%= q %> pcs</option>
                      <% } %>
                    </select>
                    <button type="submit" class="btn btn-primary flex-grow-1">Add to cart</button>
                  </form>
                <% } else { %>
                  <button class="btn btn-primary w-100 mb-2" <%= Number(product.quantity) > 0 ? '' : 'disabled' %> onclick="window.location.href='<%= isLoggedIn ? (user.role === 'admin' ? '/inventory' : '/login') : '/login' %>'">
                    <% if (!isLoggedIn) { %>
                      Sign in to add to cart
                    <% } else if (user.role !== 'user') { %>
                      Switch to shopper view
                    <% } else { %>
                      Out of stock
                    <% } %>
                  </button>
                <% } %>
                <a href="<%= detailHref %>" class="btn btn-outline-secondary w-100 rounded-pill"><%= detailLabel %></a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>

    <section class="py-5 bg-white border-top">
      <div class="container">
        <div class="row g-4">
          <div class="col-md-4">
            <div class="info-tile h-100">
              <span class="text-uppercase text-primary small fw-semibold">Why shop with us</span>
              <h5 class="mt-3">Curated tasting notes</h5>
              <p class="text-muted mb-0">Every fruit profile highlights flavour, storage tips, and serving ideas so you always pick the perfect produce.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="info-tile h-100">
              <span class="text-uppercase text-primary small fw-semibold">Community voices</span>
              <h5 class="mt-3">Verified 1-5 star reviews</h5>
              <p class="text-muted mb-0">Only registered shoppers can leave ratings, ensuring reviews you can trust before checkout.</p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="info-tile h-100">
              <span class="text-uppercase text-primary small fw-semibold">Frictionless checkout</span>
              <h5 class="mt-3">Cart & pay seamlessly</h5>
              <p class="text-muted mb-0">Add items directly from the home page and jump into the secure cart to complete your grocery run.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
</body>
</html>
