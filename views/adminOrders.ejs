<%
  const adminOrdersStyles = `
    body { background: #0b1220; color: #e2e8f0; font-family: 'Segoe UI','Helvetica Neue',Arial,sans-serif; }
    .orders-hero {
      background: linear-gradient(135deg, #0ea5e9, #22c55e);
      border-radius: 22px;
      color: #fff;
      box-shadow: 0 25px 45px rgba(0,0,0,0.24);
    }
    .orders-card {
      border: none;
      border-radius: 16px;
      background: rgba(255,255,255,0.04);
      color: #e2e8f0;
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
      backdrop-filter: blur(6px);
    }
    .table { color: #e2e8f0; background: rgba(255,255,255,0.03); }
    .table > :not(caption) > * > * {
      border-color: rgba(255,255,255,0.08);
      background-color: transparent !important;
      color: #e2e8f0;
    }
    .table-hover tbody tr,
    .table-striped tbody tr:nth-of-type(odd) { background: rgba(255,255,255,0.02); }
    .table-hover tbody tr:hover { background: rgba(255,255,255,0.06); }
  `;
%>
<%- include('partials/header', { pageTitle: 'All Orders', user, customStyles: adminOrdersStyles, bodyClass: 'bg-dark' }) %>

<div class="container py-5">
  <div class="orders-hero p-4 p-lg-5 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <p class="text-uppercase small mb-2" style="letter-spacing: 0.2rem;">Admin dashboard</p>
      <h2 class="fw-bold mb-1">All orders</h2>
      <p class="mb-0">Review shopper purchases, update statuses, and open invoices.</p>
    </div>
    <form class="row g-2 align-items-center" method="GET" action="/admin/orders">
      <div class="col-auto">
        <input type="text" name="q" class="form-control" placeholder="Filter by username or email" value="<%= search || '' %>">
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-light text-dark">Filter</button>
      </div>
      <% if (search) { %>
        <div class="col-auto">
          <a href="/admin/orders" class="btn btn-outline-light">Clear</a>
        </div>
      <% } %>
    </form>
  </div>

  <% if (messages && messages.error && messages.error.length) { %>
    <div class="alert alert-danger orders-card mb-3">
      <% messages.error.forEach(function(msg) { %><div><%= msg %></div><% }); %>
    </div>
  <% } %>
  <% if (messages && messages.success && messages.success.length) { %>
    <div class="alert alert-success orders-card mb-3">
      <% messages.success.forEach(function(msg) { %><div><%= msg %></div><% }); %>
    </div>
  <% } %>

  <% if (!orders.length) { %>
    <div class="alert alert-info orders-card">No orders yet.</div>
  <% } else { %>
    <div class="row g-3">
      <% orders.forEach(function(order) { %>
        <div class="col-12">
          <div class="card orders-card">
            <div class="card-body">
              <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div class="me-3">
                  <div class="fw-bold">Order #<%= order.id %></div>
                  <small class="text-muted">
                    Placed: <%= new Date(order.created_at).toLocaleString() %> -
                    User: <%= order.username %> (<%= order.email %>)
                  </small>
                </div>
                <div class="text-end">
                  <div class="fw-bold fs-5">$<%= Number(order.total_amount).toFixed(2) %></div>
                  <small class="text-capitalize text-muted"><%= order.payment_method %></small>
                  <div class="mt-2">
                    <a href="/admin/orders/<%= order.id %>/invoice" class="btn btn-sm btn-outline-light">Invoice</a>
                  </div>
                </div>
              </div>

              <div class="row g-3 align-items-start">
                <div class="col-lg-8">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Product</th>
                          <th>Image</th>
                          <th>Qty</th>
                          <th>Price</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% const items = orderItems[order.id] || []; %>
                        <% items.forEach(function(item) { 
                            const displayName = item.productName || item.product_name_snapshot || 'Product';
                            const image = item.image || item.product_image_snapshot;
                        %>
                          <tr>
                            <td><%= displayName %></td>
                            <td>
                              <% if (image) { %>
                                <img src="<%= image.startsWith('http') ? image : '/images/' + image %>" alt="<%= displayName %>" width="60" class="img-thumbnail">
                              <% } else { %>
                                <span class="text-muted">No image</span>
                              <% } %>
                            </td>
                            <td><%= item.quantity %></td>
                            <td>$<%= Number(item.price_at_purchase).toFixed(2) %></td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
                <div class="col-lg-4">
                  <div class="orders-card p-3 h-100">
                    <div class="fw-bold mb-2">User details</div>
                    <div class="small text-muted mb-1">Username</div>
                    <div class="mb-2"><%= order.username %></div>
                    <div class="small text-muted mb-1">Email</div>
                    <div class="mb-2"><%= order.email %></div>
                    <div class="small text-muted mb-1">Account role</div>
                    <div class="text-capitalize"><%= order.role %></div>
                  </div>
                </div>
              </div>

              <form action="/admin/orders/<%= order.id %>/status" method="POST" class="d-flex align-items-center gap-2 mt-3 flex-wrap">
                <label for="status_<%= order.id %>" class="form-label mb-0">Status</label>
                <select name="status" id="status_<%= order.id %>" class="form-select w-auto">
                  <% statuses.forEach(function(status) { %>
                    <option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= status %></option>
                  <% }); %>
                </select>
                <button type="submit" class="btn btn-outline-light btn-sm">Update</button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
